# Copy to .env.local (never commit real values).

# Supabase (leads, tiers, portfolio, site settings, admin auth, image storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, bypasses RLS. Used for markets/pricing_tiers/market_content/
# market_leads/orders (Phase 2 market routing), which have no RLS policies.
# Never prefix with NEXT_PUBLIC_, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Google Tag Manager container (GA4 is configured inside GTM), e.g. GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Search Console HTML-tag token, only if not verifying through DNS
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# AI agent (OpenAI now; Claude primary + Gemini fallback later)
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# New-lead alerts via Telegram (same bot setup as Oryn Drop; off if unset)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Random hex string used to hash visitor IPs for chat rate limiting
CHAT_IP_SALT=
